{% if oView.getEasyCreditUseApiVersionV3() %}
        <div>
            <easycredit-widget amount="{{ oView.getPriceV3() }}" webshop-id="{{ oView.getEasyCreditWebShopId() }}" />
        <div>
{% else %}
    {% if oView.isAjax() %}
        {% if oView.hasExampleCalculation() %}
            <div id="{{ oView.getViewParameter('placeholderId') }}" class="easycredit-widget">
                <span class="easycredit-suffix">{{ translate({ ident: "OXPS_EASY_CREDIT_FINANCE_FROM" }) }}</span>
                <span class="easycredit-rate">{{ oView.getExampleCalculationRate() }} € / Monat</span>
                <br>
                <a class="easycredit-link">{{ translate({ ident: "OXPS_EASY_CREDIT_MORE_INFO" }) }}</a>
            </div>

            <div id="easycredit-example-dialog"
                 title="{{ translate({ ident: "OXPS_EASY_CREDIT_EXAMPLE_DIALOG_TITLE" }) }}">
            </div>
        {% endif %}
    {% else %}
        {{ style({ include: oViewConf.getModuleUrl('osceasycredit', 'css/oxpseasycredit_style.css'), priority: 10 }) }}
        {% if oView.getUseOwnjQuery() %}
            {{ style({ include: oViewConf.getModuleUrl('osceasycredit', 'css/base/jquery-ui.css'), priority: 9 }) }}
            {{ script({ include: oViewConf.getModuleUrl('osceasycredit', 'js/libs/jquery.min.js'), priority: 8 }) }}
            {{ script({ include: oViewConf.getModuleUrl('osceasycredit', 'css/base/jquery-ui.js'), priority: 9, dynamic: __oxid_include_dynamic }) }}
        {% endif %}

        {# EasyCredit offer injects into this eleemnt #}
        <div id="{{ oView.getViewParameter('placeholderId') }}"></div>

        {% capture assign = "pageScript" %}
            //basketLoaded loaded event needs to be implemented in Apex theme
            addEventListener('basketLoaded', function (){
            console.log('added eventlistener');
            insertEasyCreditWidget{{ oView.getViewParameter('jsFunctionSuffix') }}();
            })

            function openExampleCalculationDialog (easyCreditPopupUrl) {
            $.get('{{ oView.getPopupAjaxUrl()|raw }}', function (data) {
            $('#easycredit-example-dialog').html(data);

            let dialog = $('#easycredit-example-dialog').dialog({
            close: true,
            modal: true,
            draggable: false,
            resizable: false,
            width: 570,
            height: 786,
            classes: {
            "ui-dialog": "easycredit-widget",
            "ui-dialog-titlebar-close": "btn-close"
            }
            })
            })
            }

            function insertEasyCreditWidget{{ oView.getViewParameter('jsFunctionSuffix') }}(){
            console.log('getting Ajax Data from ');
            $.get('{{ oView.getAjaxUrl()|raw }}', function(data){
            $('#{{ oView.getViewParameter('placeholderId') }}').html(data);
            $('#{{ oView.getViewParameter('placeholderId') }}').on('click', '.easycredit-link', openExampleCalculationDialog);
            });
            }

            console.log('inserting widget');
            insertEasyCreditWidget{{ oView.getViewParameter('jsFunctionSuffix') }}();
        {% endcapture %}
        {{ script({ add: pageScript, dynamic: __oxid_include_dynamic }) }}
    {% endif %}
{% endif %}
